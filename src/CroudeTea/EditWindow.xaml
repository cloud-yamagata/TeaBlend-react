<Window x:Class="CroudeTea.Views.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
        xmlns:l="http://schemas.livet-mvvm.net/2011/wpf"
        xmlns:v="clr-namespace:CroudeTea.Views"
        xmlns:vm="clr-namespace:CroudeTea.ViewModels"
        Title="第2工場製造ロット登録画面" Height="700" Width="1200"
        ResizeMode="NoResize" Margin="10,10,0,0">

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="HighlightTextBox" TargetType="TextBox">
                <!--StyleにTrriggerを定義-->
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                        <!--IsFocusedがTrueの場合、下の値を適用-->
                        <Setter Property="Background" Value="Yellow" />
                    </Trigger>
                    <Trigger Property="IsFocused" Value="False">
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadOnlyTextBox" TargetType="TextBox">
                <!--StyleにTrriggerを定義-->
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReadOnlyChk}" Value="True">
                        <Setter Property="IsReadOnly" Value="True"/>
                        <Setter Property="Background" Value="GhostWhite"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsReadOnlyChk}" Value="False">
                        <Setter Property="IsReadOnly" Value="False"/>
                        <Setter Property="Background" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BorderStyle" TargetType="Border">
                <Setter Property="Background" Value="lemonchiffon"/>
                <Setter Property="Background" Value="ivory"/>
                <Setter Property="Background" Value="skyblue"/>
                <Setter Property="Background" Value="lavender"/>
                <Setter Property="Background" Value="lightyellow"/>
                <Setter Property="Background" Value="gainsboro"/>
                <Setter Property="Background" Value="lavender"/>
            </Style>
            <Style x:Key="FocusDisable" TargetType="{x:Type Button}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
            <Style x:Key="TextBlockRightStyle" TargetType="{x:Type TextBlock}" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style x:Key="TextBoxRightStyle" TargetType="{x:Type TextBox}" BasedOn="{x:Static DataGridTextColumn.DefaultEditingElementStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 
    <Window.DataContext>
        <local:PackageBind ProductName="tanaka" ProductNo="34" />
    </Window.DataContext>
    -->
    <Window.DataContext>
        <vm:EditWindowViewModel/>
    </Window.DataContext>

    <i:Interaction.Triggers>

        <!--Viewに特別な要件が存在しない限りは、トリガーやアクションの自作にこだわらず積極的にコードビハインドを使いましょう -->
        <!--Viewのコードビハインドは、基本的にView内で完結するロジックとViewModelからのイベントの受信(専用リスナを使用する)に限るとトラブルが少なくなります -->
        <!--Livet1.1からはコードビハインドでViewModelのイベントを受信するためのWeakEventLisnterサポートが追加されています -->

        <!--WindowのContentRenderedイベントのタイミングでViewModelのInitializeメソッドが呼ばれます-->
        <i:EventTrigger EventName="ContentRendered">
            <l:LivetCallMethodAction MethodTarget="{Binding}" MethodName="Initialize"/>
        </i:EventTrigger>

        <!--Windowが閉じたタイミングでViewModelのDisposeメソッドが呼ばれます-->
        <i:EventTrigger EventName="Closed">
            <l:DataContextDisposeAction/>
        </i:EventTrigger>

        <!--WindowのCloseキャンセル処理に対応する場合は、WindowCloseCancelBehaviorの使用を検討してください-->
        <l:InteractionMessageTrigger Messenger="{Binding Messenger}" MessageKey="WindowClose">
            <l:WindowInteractionMessageAction />
        </l:InteractionMessageTrigger>
    </i:Interaction.Triggers>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Horizontal" Margin="10,0">
        <!-- 製造報告書登録画面 -->
        <StackPanel Width="650" Margin="0,0,0,19">
            <!-- ヘッダ -->
            <StackPanel Orientation="Horizontal">
                <Label BorderBrush="Black" Content="第2工場製造ロット登録" FontSize="14" HorizontalAlignment="Center" Background="Transparent"/>
                <Border BorderBrush="White" BorderThickness="0" Height="5"  Width="5"></Border>
                <Button Width="50" Height="20" Command="{Binding InsertCommand}">登録
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInsertChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="50" Height="20" Command="{Binding UpdateCommand}">変更
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="50" Height="20" Command="{Binding DeleteCommand}">削除
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="50" Height="20" IsEnabled="{Binding UpdateEnabled.Value}" Command="{Binding PrintCommand}">報告書</Button>
                <Button Width="50" Height="20" IsEnabled="{Binding UpdateEnabled.Value}" Command="{Binding PDFCommand}">→PDF</Button>
                <Button Width="50" Height="20" Command="{Binding GradeCommand}">格付表
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGradeChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="40">
                    <TextBox Grid.Row="0" Grid.Column="2"
                        Text="{Binding EditTarget.Value.grade_no.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}" IsReadOnly="True"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" TextAlignment="Right" Height="20" Width="40"/>
                </Border>
                <Button Width="50" Height="20" Command="{Binding GradePDFCommand}">→PDF
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGradeChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Border BorderBrush="White" BorderThickness="0" Height="5"  Width="5"></Border>
                <Button Width="50" Height="20" Command="{Binding StoreCommand}">在庫確定
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegistChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
            <!-- 製造No. -->

            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="50" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="製造No" Width="50" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="70">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding EditTarget.Value.organic_class.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="15" Margin="3,5,0,0"/>
                        <Label BorderBrush="Black" Content="-" Width="10" Padding="0" Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding EditTarget.Value.product_no.Value, UpdateSourceTrigger=PropertyChanged}"  Height="24" Width="40" Margin="0,5"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="30" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="年" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="30">
                    <TextBox
                        Text="{Binding EditTarget.Value.make_year.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"                    
                        HorizontalAlignment="Left" TextAlignment="Left" Height="30" Width="30" VerticalContentAlignment="Stretch"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="50" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="通称名" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="200">
                    <TextBox x:Name="TextBox_ProductName"
                        Text="{Binding EditTarget.Value.item_name.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}" IsReadOnly="True"                   
                        HorizontalAlignment="Left" TextAlignment="Left" Height="30" Width="200" IsHitTestVisible="True" VerticalContentAlignment="Stretch"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="35" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="回数" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="30">
                    <TextBox
                        Text="{Binding EditTarget.Value.count.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Left" TextAlignment="Left" Height="30" Width="30"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="50" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="生産日" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="95">
                    <DatePicker Height="30" SelectedDate="{Binding EditTarget.Value.work_date.Value, UpdateSourceTrigger=PropertyChanged}" Text="製造日"  HorizontalAlignment="Right" Width="95"/>
                </Border>
            </StackPanel>
            <!-- 隙間 -->
            <StackPanel>
                <Border BorderBrush="White" BorderThickness="0" Height="5"  Width="1"></Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="50" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="茶区分" Width="50" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="200">
                    <WrapPanel Margin="5,8,0,0">
                        <RadioButton Content="有機茶" IsChecked="{Binding EditTarget.Value.isOrganicClickA.Value, Mode=TwoWay}" Height="20"/>
                        <RadioButton Content="無農薬茶" IsChecked="{Binding EditTarget.Value.isOrganicClickB.Value, Mode=TwoWay}" Height="20"/>
                        <RadioButton Content="一般茶" IsChecked="{Binding EditTarget.Value.isOrganicClickC.Value, Mode=TwoWay}" Height="20"/>
                    </WrapPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="60" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="プロセス" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="320">
                    <WrapPanel Margin="5,8,0,0">
                        <RadioButton Content="02:荒茶配合" IsChecked="{Binding EditTarget.Value.isProcessClick02.Value, Mode=TwoWay}" Height="16" IsEnabled="False"/>
                        <RadioButton Content="03:仕上" IsChecked="{Binding EditTarget.Value.isProcessClick03.Value, Mode=TwoWay}" Height="16" IsEnabled="False"/>
                        <RadioButton Content="04:火入" IsChecked="{Binding EditTarget.Value.isProcessClick04.Value, Mode=TwoWay}" Height="16" IsEnabled="False"/>
                        <RadioButton Content="05:仕上配合" IsChecked="{Binding EditTarget.Value.isProcessClick05.Value, Mode=TwoWay}" Height="16" IsEnabled="False"/>
                    </WrapPanel>
                </Border>
            </StackPanel>            

            <!-- 隙間 -->
            <StackPanel>
                <Border BorderBrush="White" BorderThickness="0" Height="5"  Width="1"></Border>
            </StackPanel>

            <!-- 製造No. -->
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="180" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="部品名" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="50" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="梱包重量" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0" Height="18" VerticalAlignment="Top"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="50"  Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="梱包数" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="50" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="端数重量" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="50"  Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="端数数" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="70" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="製造数(Kg)" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0" />
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="70" Style="{StaticResource BorderStyle}">
                    <!--<Label BorderBrush="Black" Content="投入数(Kg)" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0" />-->
                    <Button Width="70" Background="palegreen" IsEnabled="{Binding EditEnabled.Value}">投入数(Kg)
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Click">
                                <l:LivetCallMethodAction MethodTarget="{Binding Mode=OneWay}" MethodName="InputQuantity"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </Button>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="110" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="適用" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0" />
                </Border>
            </StackPanel>
            <ScrollViewer Height="20"                       
                Focusable="False" VerticalScrollBarVisibility="Auto">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <!-- 部品名 -->
                        <ColumnDefinition Width="50"/>
                        <!-- 梱包重量 -->
                        <ColumnDefinition Width="50"/>
                        <!-- 梱包数 -->
                        <ColumnDefinition Width="50"/>
                        <!-- 端数重量 -->
                        <ColumnDefinition Width="50"/>
                        <!-- 端数数 -->
                        <ColumnDefinition Width="70"/>
                        <!-- 生産量 -->
                        <ColumnDefinition Width="70"/>
                        <!-- 投入量 -->
                        <ColumnDefinition Width="110"/>
                        <!-- 適用 -->
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1">
                        <TextBox Grid.Row="0" Grid.Column="3"
                            Text="{Binding EditTarget.Value.lot_name.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                            Style="{StaticResource HighlightTextBox}"                    
                            HorizontalAlignment="Left" 
                            VerticalAlignment="Center" TextAlignment="Left" Height="20" Width="230"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="1">
                        <TextBox
                        Text="{Binding EditTarget.Value.unit_weight.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"                    
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" TextAlignment="Right" Height="20" Width="50"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="1">
                        <TextBox
                        Text="{Binding EditTarget.Value.unit_number.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"                    
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" TextAlignment="Right" Height="20" Width="50"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                        <TextBox
                        Text="{Binding EditTarget.Value.fraction_weight.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" TextAlignment="Right" Height="20" Width="50"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="4" BorderBrush="Black" BorderThickness="1">
                        <TextBox
                        Text="{Binding EditTarget.Value.fraction_number.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"                    
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" TextAlignment="Right" Height="20" Width="50"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="5" BorderBrush="Black" BorderThickness="1">
                        <TextBlock Text="{Binding EditTarget.Value.product_quantity.Value, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" TextAlignment="Right" Height="20" Width="70"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="6" BorderBrush="Black" BorderThickness="1">
                        <TextBlock Text="{Binding input_quantity, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" TextAlignment="Right" Height="20" Width="70"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="7" BorderBrush="Black" BorderThickness="1">
                        <TextBox
                        Text="{Binding EditTarget.Value.remarks.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center" TextAlignment="Left" Height="20" Width="110"/>
                    </Border>
                </Grid>
            </ScrollViewer>
            <!-- 隙間 -->
            <StackPanel>
                <Border BorderBrush="White" BorderThickness="0" Height="10"  Width="1"></Border>
            </StackPanel>
            <!-- 賞味期限 -->
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="150">
                    <Border BorderBrush="Black" BorderThickness="1" Height="15" Style="{StaticResource BorderStyle}">
                        <Label BorderBrush="Black" Content="使用機械" HorizontalAlignment="Center" Padding="0" />
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="Black" BorderThickness="1" Height="35" Width="50">
                            <StackPanel HorizontalAlignment="Center">
                                <Label BorderBrush="Black" Content="1号機" Padding="0" HorizontalAlignment="Center" FontSize="9"/>
                                <TextBlock Padding="0" HorizontalAlignment="Center" >
                                    <InlineUIContainer><CheckBox  Padding="0" IsChecked="{Binding EditTarget.Value.use_device_unit1_chk.Value, UpdateSourceTrigger=PropertyChanged}"/></InlineUIContainer>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="1" Height="35" Width="50">
                            <StackPanel HorizontalAlignment="Center">
                                <Label BorderBrush="Black" Content="2号機" Padding="0" HorizontalAlignment="Center" FontSize="9"/>
                                <TextBlock Padding="0" HorizontalAlignment="Center" >
                                    <InlineUIContainer><CheckBox  Padding="0" IsChecked="{Binding EditTarget.Value.use_device_unit2_chk.Value, UpdateSourceTrigger=PropertyChanged}"/></InlineUIContainer>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="1" Height="35" Width="50">
                            <StackPanel HorizontalAlignment="Center">
                                <Label BorderBrush="Black" Content="3号機" Padding="0" HorizontalAlignment="Center" FontSize="9"/>
                                <TextBlock Padding="0" HorizontalAlignment="Center" >
                                    <InlineUIContainer><CheckBox  Padding="0" IsChecked="{Binding EditTarget.Value.use_device_unit3_chk.Value, UpdateSourceTrigger=PropertyChanged}"/></InlineUIContainer>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Width="100">
                    <Border BorderBrush="Black" BorderThickness="1" Height="15" Style="{StaticResource BorderStyle}">
                        <Label BorderBrush="Black" Content="上り梱包形態" HorizontalAlignment="Center" Padding="0" />
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="Black" BorderThickness="1" Height="35" Width="50">
                            <StackPanel HorizontalAlignment="Center">
                                <Label BorderBrush="Black" Content="窒素ﾀﾞﾝﾎﾞｰﾙ" Padding="0" HorizontalAlignment="Center" FontSize="9"/>
                                <TextBlock Padding="0" HorizontalAlignment="Center" >
                                    <InlineUIContainer><CheckBox  Padding="0" IsChecked="{Binding EditTarget.Value.packing_case1_chk.Value, UpdateSourceTrigger=PropertyChanged}"/></InlineUIContainer>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="1" Height="35" Width="50">
                            <StackPanel HorizontalAlignment="Center">
                                <Label BorderBrush="Black" Content="大海袋" Padding="0" HorizontalAlignment="Center" FontSize="9"/>
                                <TextBlock Padding="0" HorizontalAlignment="Center" >
                                    <InlineUIContainer><CheckBox  Padding="0" IsChecked="{Binding EditTarget.Value.packing_case2_chk.Value, UpdateSourceTrigger=PropertyChanged}"/></InlineUIContainer>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <!-- 確認チェック -->
                <StackPanel Width="300">
                    <Border BorderBrush="Black" BorderThickness="1" Height="15" Style="{StaticResource BorderStyle}">
                        <Label BorderBrush="Black" Content="確認チェック" HorizontalAlignment="Center" Padding="0" />
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="Black" BorderThickness="1" Height="35" Width="50">
                            <StackPanel HorizontalAlignment="Center">
                                <Label BorderBrush="Black" Content="作業前清掃" Padding="0" HorizontalAlignment="Center" FontSize="9"/>
                                <TextBlock Padding="0" HorizontalAlignment="Center" >
                                    <InlineUIContainer><CheckBox  Padding="0" IsChecked="{Binding EditTarget.Value.work_before_cleaning_chk.Value, UpdateSourceTrigger=PropertyChanged}"/></InlineUIContainer>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="1" Height="35" Width="50">
                            <StackPanel HorizontalAlignment="Center">
                                <Label BorderBrush="Black" Content="作業後清掃" Padding="0" HorizontalAlignment="Center" FontSize="9"/>
                                <TextBlock Padding="0" HorizontalAlignment="Center" >
                                    <InlineUIContainer><CheckBox  Padding="0" IsChecked="{Binding EditTarget.Value.work_after_cleaning_chk.Value, UpdateSourceTrigger=PropertyChanged}"/></InlineUIContainer>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="1" Height="35" Width="50">
                            <StackPanel HorizontalAlignment="Center">
                                <Label BorderBrush="Black" Content="装置設定" Padding="0" HorizontalAlignment="Center" FontSize="9"/>
                                <TextBlock Padding="0" HorizontalAlignment="Center" >
                                    <InlineUIContainer><CheckBox  Padding="0" IsChecked="{Binding EditTarget.Value.device_chk.Value, UpdateSourceTrigger=PropertyChanged}"/></InlineUIContainer>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="1" Height="35" Width="50">
                            <StackPanel HorizontalAlignment="Center">
                                <Label BorderBrush="Black" Content="空動作" Padding="0" HorizontalAlignment="Center" FontSize="9"/>
                                <TextBlock Padding="0" HorizontalAlignment="Center" >
                                <InlineUIContainer><CheckBox  Padding="0" IsChecked="{Binding EditTarget.Value.operation_chk.Value, UpdateSourceTrigger=PropertyChanged}"/></InlineUIContainer>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="1" Height="35" Width="50">
                            <StackPanel HorizontalAlignment="Center">
                                <Label BorderBrush="Black" Content="残留物" Padding="0" HorizontalAlignment="Center" FontSize="9"/>
                                <TextBlock Padding="0" HorizontalAlignment="Center" >
