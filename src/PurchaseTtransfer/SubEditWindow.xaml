<Window x:Class="PurchaseTtransfer.Views.SubEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
        xmlns:l="http://schemas.livet-mvvm.net/2011/wpf"
        xmlns:v="clr-namespace:PurchaseTtransfer.Views"
        xmlns:vm="clr-namespace:PurchaseTtransfer.ViewModels"
        Title="仕入振分実績メンテナンス"
        Height="350" 
        Width="650" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterOwner" FontSize="12" WindowState="Normal" Topmost="False">

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="HighlightTextBox" TargetType="TextBox">
                <!--StyleにTrriggerを定義-->
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                        <!--IsFocusedがTrueの場合、下の値を適用-->
                        <Setter Property="Background" Value="Yellow" />
                    </Trigger>
                    <Trigger Property="IsFocused" Value="False">
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadOnlyTextBox" TargetType="TextBox">
                <!--StyleにTrriggerを定義-->
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReadOnlyChk}" Value="True">
                        <Setter Property="IsReadOnly" Value="True"/>
                        <Setter Property="Background" Value="GhostWhite"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsReadOnlyChk}" Value="False">
                        <Setter Property="IsReadOnly" Value="False"/>
                        <Setter Property="Background" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BorderStyle" TargetType="Border">
                <Setter Property="Background" Value="lemonchiffon"/>
                <Setter Property="Background" Value="ivory"/>
                <Setter Property="Background" Value="skyblue"/>
                <Setter Property="Background" Value="lavender"/>
                <Setter Property="Background" Value="lightyellow"/>
                <Setter Property="Background" Value="gainsboro"/>
                <Setter Property="Background" Value="lavender"/>
            </Style>
            <Style x:Key="FocusDisable" TargetType="{x:Type Button}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <vm:SubEditWindowViewModel/>
    </Window.DataContext>

    <i:Interaction.Triggers>

        <!--Viewに特別な要件が存在しない限りは、トリガーやアクションの自作にこだわらず積極的にコードビハインドを使いましょう -->
        <!--Viewのコードビハインドは、基本的にView内で完結するロジックとViewModelからのイベントの受信(専用リスナを使用する)に限るとトラブルが少なくなります -->
        <!--Livet1.1からはコードビハインドでViewModelのイベントを受信するためのWeakEventLisnterサポートが追加されています -->

        <!--WindowのContentRenderedイベントのタイミングでViewModelのInitializeメソッドが呼ばれます-->
        <i:EventTrigger EventName="ContentRendered">
            <l:LivetCallMethodAction MethodTarget="{Binding}" MethodName="Initialize"/>
        </i:EventTrigger>

        <!--Windowが閉じたタイミングでViewModelのDisposeメソッドが呼ばれます-->
        <i:EventTrigger EventName="Closed">
            <l:DataContextDisposeAction/>
        </i:EventTrigger>

        <!--WindowのCloseキャンセル処理に対応する場合は、WindowCloseCancelBehaviorの使用を検討してください-->
        <l:InteractionMessageTrigger Messenger="{Binding Messenger}" MessageKey="SubWindowClose">
            <l:WindowInteractionMessageAction />
        </l:InteractionMessageTrigger>
    </i:Interaction.Triggers>

    <StackPanel Orientation="Horizontal" Margin="10,0">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="5"></Border>
                <Button Width="60" Height="20" Content="登録" IsEnabled="{Binding InsertEnabled.Value}" Background="DarkGreen" Foreground="white"
                    Command="{Binding InsertCommand}"
                    HorizontalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInsertChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border Width="2"></Border>
                <Button Width="60" Height="20" Content="変更" IsEnabled="{Binding UpdateEnabled.Value}" Background="DarkGreen" Foreground="white"
                    Command="{Binding UpdateCommand}"
                    HorizontalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border Width="2"></Border>
                <Button Width="60" Height="20" Content="削除" IsEnabled="{Binding DeleteEnabled.Value}" Background="DarkGreen" Foreground="white"
                    Command="{Binding DeleteCommand}"
                    HorizontalAlignment="Center">
                </Button>
                <Border Width="2"></Border>
                <Button Width="60" Height="20" Content="一括振分" IsEnabled="{Binding TransferEnabled.Value}" Background="DarkGreen" Foreground="white"
                    Command="{Binding TransferCommand}"
                    HorizontalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border Width="2"></Border>
                <Button Width="57" Height="20" Content="キャンセル" Background="DarkGreen" Foreground="white"
                    Command="{Binding CancelCommand}"
                    HorizontalAlignment="Center">
                </Button>
            </StackPanel>

            <Grid Background="Honeydew">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition />

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="5" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="2" Background="Plum">
                    <TextBlock Text="*年度" Padding="8,0" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Background="Plum"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="4" Background="Plum">
                    <TextBlock Text="*仕入先" Padding="8,0" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Background="Plum"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="6" Background="Plum">
                    <TextBlock Text="*入札NO" Padding="8,0" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Background="Plum"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="8" Background="Plum">
                    <TextBlock Text="*振分種別" Padding="8,0" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Background="Plum"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="10" Background="Plum">
                    <TextBlock Text="*振分先" Padding="8,0" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Background="Plum"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="12">
                    <TextBlock Text="振分日" Padding="8,0" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="14">
                    <TextBlock Text="梱包(重量/数)" Padding="8,0" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="16">
                    <TextBlock Text="端数(重量/数)" Padding="8,0" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="18">
                    <Button Width="100" Height="24" Content="お届価格" Padding="8,0" IsEnabled="{Binding PriceEnabled.Value}" Background="DarkGreen" Foreground="white"
                    Command="{Binding PriceCommand}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                    </Button>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="20">
                    <TextBlock Text="摘要" Padding="8,0" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                </Border>
                <TextBox Grid.Column="3" Grid.Row="2" BorderBrush="RoyalBlue" TextAlignment="Right" FontSize="16"
                     Text="{Binding EditTarget.Value.year.Value, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource HighlightTextBox}" IsReadOnly="False"
                     ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" IsEnabled="False"/>
                <TextBox Grid.Column="3" Grid.Row="4" BorderBrush="RoyalBlue" TextAlignment="Left" FontSize="16"
                     Text="{Binding EditTarget.Value.purchase.Value, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource HighlightTextBox}" IsReadOnly="False"
                     ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" IsEnabled="False"/>
                <TextBox Grid.Column="3" Grid.Row="6" BorderBrush="RoyalBlue" TextAlignment="Left" FontSize="16"
                     Text="{Binding EditTarget.Value.bid_no.Value, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource HighlightTextBox}" IsReadOnly="False"
                     ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" IsEnabled="False"/>
                <StackPanel Grid.Column="3" Grid.Row="8" Orientation="Horizontal" Width="200">
                    <TextBox BorderBrush="RoyalBlue" TextAlignment="Left" Width="50" FontSize="16"
                         Text="{Binding EditTarget.Value.result_type.Value, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource HighlightTextBox}" IsReadOnly="False"
                         ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" IsEnabled="False"/>
                    <WrapPanel Margin="5,5,0,0">
                        <RadioButton Content="工場" IsChecked="{Binding EditTarget.Value.isResultType1.Value, Mode=TwoWay}" Height="20"/>
                        <RadioButton Content="転売" IsChecked="{Binding EditTarget.Value.isResultType2.Value, Mode=TwoWay}" Height="20"/>
                        <RadioButton Content="児湯茶" IsChecked="{Binding EditTarget.Value.isResultType3.Value, Mode=TwoWay}" Height="20"/>
                    </WrapPanel>

                    <!--<TextBox BorderBrush="RoyalBlue" TextAlignment="Left" Width="100" FontSize="16"
                         Text="{Binding EditTarget.Value.result_type_name.Value, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource HighlightTextBox}" IsReadOnly="False"
                         ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" IsEnabled="False"/>-->
                </StackPanel>                
                <TextBox Grid.Column="3" Grid.Row="10" BorderBrush="RoyalBlue" TextAlignment="Left" FontSize="16"
                     Text="{Binding EditTarget.Value.transfer.Value, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource HighlightTextBox}" IsReadOnly="False"
                     ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"/>
                <DatePicker Grid.Column="3" Grid.Row="12" BorderBrush="RoyalBlue" FontSize="16" 
                     SelectedDate="{Binding EditTarget.Value.transfer_date.Value, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"/>
                <StackPanel Grid.Column="3" Grid.Row="14" Orientation="Horizontal" Width="200">
                    <TextBox BorderBrush="RoyalBlue" TextAlignment="Right" Width="100" FontSize="16"
                         Text="{Binding EditTarget.Value.unit_weight.Value, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource HighlightTextBox}" IsReadOnly="False"
                         ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" IsEnabled="False"/>
                    <TextBox BorderBrush="RoyalBlue" TextAlignment="Right" Width="100" FontSize="16"
                         Text="{Binding EditTarget.Value.unit_number.Value, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource HighlightTextBox}" IsReadOnly="False"
                         ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                         InputMethod.PreferredImeState="On" InputMethod.PreferredImeConversionMode="Alphanumeric"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Grid.Row="16" Orientation="Horizontal" Width="200">
                    <TextBox BorderBrush="RoyalBlue" TextAlignment="Right" Width="100" FontSize="16"
                         Text="{Binding EditTarget.Value.fraction_weight.Value, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource HighlightTextBox}" IsReadOnly="False"
                         ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" IsEnabled="False"/>
                    <TextBox BorderBrush="RoyalBlue" TextAlignment="Right" Width="100" FontSize="16"
                         Text="{Binding EditTarget.Value.fraction_number.Value, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource HighlightTextBox}" IsReadOnly="False"
                         ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                         InputMethod.PreferredImeState="On" InputMethod.PreferredImeConversionMode="Alphanumeric"/>
                </StackPanel>
                <TextBox Grid.Column="3" Grid.Row="18" BorderBrush="RoyalBlue" TextAlignment="Right" FontSize="16"
                     Text="{Binding EditTarget.Value.unit_price.Value, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource HighlightTextBox}" IsReadOnly="False"
                     ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"/>
                <TextBox Grid.Column="3" Grid.Row="20" BorderBrush="RoyalBlue" TextAlignment="Left" FontSize="16"
                     Text="{Binding EditTarget.Value.remarks.Value, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource HighlightTextBox}" IsReadOnly="False"                         
                     ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"/>
            </Grid>
        </StackPanel>

        <TabControl TabStripPlacement="Left" Name="tabContr0" Width="300" Background="yellowgreen">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="LayoutTransform">
                        <Setter.Value>
                            <TransformGroup>
                                <RotateTransform Angle="90"/>
                            </TransformGroup>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="転売先" Name="tabItem0" Background="palegreen">
                <ScrollViewer Name="MyScrollViewer" RenderTransformOrigin="0.5,0.5"  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None">
                        <WrapPanel Name="wrapPanel0" Width="{Binding ElementName=MyScrollViewer, Path=ViewportWidth}">
                        </WrapPanel>
                    </Viewbox>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </StackPanel>
</Window>
