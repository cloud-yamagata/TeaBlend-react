<Window x:Class="PackageReport.Views.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
        xmlns:l="http://schemas.livet-mvvm.net/2011/wpf"
        xmlns:v="clr-namespace:PackageReport.Views"
        xmlns:vm="clr-namespace:PackageReport.ViewModels"
        Title="製造報告書登録画面" Height="780" Width="1200"
        ResizeMode="NoResize" Margin="10,10,0,0">

    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="HighlightTextBox" TargetType="TextBox">
                <!--StyleにTrriggerを定義-->
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                        <!--IsFocusedがTrueの場合、下の値を適用-->
                        <Setter Property="Background" Value="Yellow" />
                    </Trigger>
                    <Trigger Property="IsFocused" Value="False">
                        <Setter Property="Background" Value="White" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ReadOnlyTextBox" TargetType="TextBox">
                <!--StyleにTrriggerを定義-->
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsReadOnlyChk}" Value="True">
                        <Setter Property="IsReadOnly" Value="True"/>
                        <Setter Property="Background" Value="GhostWhite"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsReadOnlyChk}" Value="False">
                        <Setter Property="IsReadOnly" Value="False"/>
                        <Setter Property="Background" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BorderStyle" TargetType="Border">
                <Setter Property="Background" Value="lemonchiffon"/>
                <Setter Property="Background" Value="ivory"/>
                <Setter Property="Background" Value="skyblue"/>
                <Setter Property="Background" Value="lavender"/>
                <Setter Property="Background" Value="lightyellow"/>
                <Setter Property="Background" Value="gainsboro"/>
                <Setter Property="Background" Value="lavender"/>
            </Style>
            <Style x:Key="FocusDisable" TargetType="{x:Type Button}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- 
    <Window.DataContext>
        <local:PackageBind ProductName="tanaka" ProductNo="34" />
    </Window.DataContext>
    -->
    <Window.DataContext>
        <vm:EditWindowViewModel/>
    </Window.DataContext>

    <i:Interaction.Triggers>

        <!--Viewに特別な要件が存在しない限りは、トリガーやアクションの自作にこだわらず積極的にコードビハインドを使いましょう -->
        <!--Viewのコードビハインドは、基本的にView内で完結するロジックとViewModelからのイベントの受信(専用リスナを使用する)に限るとトラブルが少なくなります -->
        <!--Livet1.1からはコードビハインドでViewModelのイベントを受信するためのWeakEventLisnterサポートが追加されています -->

        <!--WindowのContentRenderedイベントのタイミングでViewModelのInitializeメソッドが呼ばれます-->
        <i:EventTrigger EventName="ContentRendered">
            <l:LivetCallMethodAction MethodTarget="{Binding}" MethodName="Initialize"/>
        </i:EventTrigger>

        <!--Windowが閉じたタイミングでViewModelのDisposeメソッドが呼ばれます-->
        <i:EventTrigger EventName="Closed">
            <l:DataContextDisposeAction/>
        </i:EventTrigger>

        <!--WindowのCloseキャンセル処理に対応する場合は、WindowCloseCancelBehaviorの使用を検討してください-->
        <l:InteractionMessageTrigger Messenger="{Binding Messenger}" MessageKey="WindowClose">
            <l:WindowInteractionMessageAction />
        </l:InteractionMessageTrigger>
    </i:Interaction.Triggers>

    <StackPanel Orientation="Horizontal" Margin="10,0,10,-2">
        <!-- 製造報告書登録画面 -->
        <StackPanel Width="650" Margin="0,0,0,25">
            <!-- ヘッダ -->
            <StackPanel Orientation="Horizontal">
                <Label BorderBrush="Black" Content="製造報告書（パッケージ）" FontSize="14" HorizontalAlignment="Center" Background="Transparent"/>
                <Border BorderBrush="White" BorderThickness="0" Height="5"  Width="5"></Border>
                <!--
                <Button Width="50" Height="20" IsEnabled="{Binding ConfirmEnabled.Value}" Command="{Binding ConfirmCommand}">確認</Button>
                <Button Width="50" Height="20" IsEnabled="{Binding UpdateEnabled.Value}" Command="{Binding InsertCommand}">登録</Button>
                <Button Width="50" Height="20" IsEnabled="{Binding UpdateEnabled.Value}" Command="{Binding UpdateCommand}">変更</Button>
                <Button Width="50" Height="20" IsEnabled="{Binding DeleteEnabled.Value}" Command="{Binding DeleteCommand}">削除</Button>
                <Border BorderBrush="White" BorderThickness="0" Height="5"  Width="5"></Border>                
                <Button Width="50" Height="20" Command="{Binding ConfirmCommand}">確認
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                -->
                <Button Width="50" Height="20" Command="{Binding InsertCommand}">登録
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInsertChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="50" Height="20" Command="{Binding UpdateCommand}">変更
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="50" Height="20" Command="{Binding DeleteCommand}">削除
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUpdateChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="50" Height="20" IsEnabled="{Binding UpdateEnabled.Value}" Command="{Binding PrintCommand}">報告書</Button>
                <Button Width="50" Height="20" IsEnabled="{Binding UpdateEnabled.Value}" Command="{Binding PDFCommand}">→PDF</Button>
                <Button Width="50" Height="20" Command="{Binding GradeCommand}">格付表
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGradeChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Width="50" Height="20" Command="{Binding GradePDFCommand}">→PDF
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGradeChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Border BorderBrush="White" BorderThickness="0" Height="5"  Width="5"></Border>
                <Button Width="50" Height="20" Command="{Binding StoreCommand}">在庫確定
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegistChk}" Value="True">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Border BorderBrush="White" BorderThickness="0" Height="5"  Width="5"></Border>
                <Button Width="50" Height="20" Command="{Binding Clear}">CLEAR</Button>
            </StackPanel>
            <!-- 製造No. -->
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="50" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="製造No" Width="50" Padding="0" HorizontalAlignment="Center" VerticalContentAlignment="Center"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="90">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding organic_class, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="15" Margin="3,5,0,0"/>
                        <Label BorderBrush="Black" Content="-" Width="10" Padding="0" Margin="0,5,0,0"/>
                        <!--ReadOnlyにするにはIsReadOnlyプロパティをTrueにします-->
                        <TextBlock Text="{Binding EditTarget.Value.product_no.Value, UpdateSourceTrigger=PropertyChanged}"  Height="24" Width="50" Margin="0,5"/>
                        <!--<TextBox Text="{Binding EditTarget.Value.product_no.Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" Height="24" Width="50" Margin="0,2"/>-->
                    </StackPanel>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="90" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="製品名" Width="54" Padding="0" HorizontalAlignment="Left" VerticalContentAlignment="Center" Margin="17.2,0.2,0,-0.2" />
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="30" Width="410">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding EditTarget.Value.product_name.Value, UpdateSourceTrigger=PropertyChanged}" x:Name="TextBox_ProductName" IsReadOnly="True" Style="{StaticResource HighlightTextBox}" Height="25" Width="400" />
                    </StackPanel>
                </Border>

            </StackPanel>
            <!-- 隙間 -->
            <StackPanel>
                <Border BorderBrush="White" BorderThickness="0" Height="5"  Width="1"></Border>
            </StackPanel>
            <!-- 茶区分 -->
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="Black" BorderThickness="1" Height="60" Width="50" Style="{StaticResource BorderStyle}">
                    <TextBlock Height="50" Width="20" Margin="14.2,0,13.8,3.8" VerticalAlignment="Bottom">茶<LineBreak />区<LineBreak />分</TextBlock>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="60" Width="80">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <GroupBox  Width="80" Margin="0,3,0,0">
                            <StackPanel>
                                <RadioButton Content="有機茶" x:Name="RadioButton_Organic_A" IsChecked="{Binding Click1, Mode=TwoWay}" Height="16"/>
                                <RadioButton Content="無農薬茶" x:Name="RadioButton_Organic_B" IsChecked="{Binding Click2, Mode=TwoWay}" Height="16"/>
                                <RadioButton Content="一般茶" x:Name="RadioButton_Organic_C" IsChecked="{Binding Click3, Mode=TwoWay}" Height="16"/>
                                <!-- <TextBlock x:Name="textBlockSelected" />  -->
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Border>
                <Border BorderBrush="White" BorderThickness="1" Width="190">
                    <StackPanel>
                        <Border BorderBrush="White" BorderThickness="0" Height="35">
                            <DatePicker Height="20" SelectedDate="{Binding EditTarget.Value.work_date.Value, UpdateSourceTrigger=PropertyChanged}" Text="製造日"  HorizontalAlignment="Right" Padding="0" Width="100"/>
                        </Border>
                        <WrapPanel>
                            <Border BorderBrush="White" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Label BorderBrush="Black" Content="室内温度・湿度"/>
                                    <TextBox Text="{Binding EditTarget.Value.temperature.Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" Style="{StaticResource HighlightTextBox}" HorizontalContentAlignment="Right"  Height="20" Width="35"/>
                                    <Label BorderBrush="Black" Content="℃" Width="15" Padding="0" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                                    <TextBox Text="{Binding EditTarget.Value.humidity.Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" Style="{StaticResource HighlightTextBox}" HorizontalContentAlignment="Right"  Height="20" Width="35"/>
                                    <Label BorderBrush="Black" Content="％" Width="15" Padding="0" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border BorderBrush="White" BorderThickness="1" Width="10"></Border>
                <Border BorderBrush="Black" BorderThickness="1" Width="310">
                    <WrapPanel Name="wrapPanelcal">
                    </WrapPanel>
                </Border>
            </StackPanel>
            <!-- 隙間 -->
            <StackPanel>
                <Border BorderBrush="White" BorderThickness="0" Height="2"  Width="1"></Border>
            </StackPanel>
            <!-- 製造No. -->
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="150" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="使用茶　品名" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="110"  Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="ロット" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="100" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="出庫数量(Kg)" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="100" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="使用数量(Kg)" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="80" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="出来上り個数" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0" />
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="20" Width="100" Style="{StaticResource BorderStyle}">
                    <Label BorderBrush="Black" Content="使用残(Kg)" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0" />
                </Border>

            </StackPanel>
            <ScrollViewer Height="60" x:Name="_scrollViewer"                         
                Focusable="False" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="_detailLines">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <!-- 使用茶　品名 -->
                        <ColumnDefinition Width="110"/>
                        <!-- ロット -->
                        <ColumnDefinition Width="100"/>
                        <!-- 出庫数量( -->
                        <ColumnDefinition Width="100"/>
                        <!-- 使用数量 -->
                        <ColumnDefinition Width="80"/>
                        <!-- 出来上り個数 -->
                        <ColumnDefinition Width="100"/>
                        <!-- 使用残 -->
                        <!--<ColumnDefinition Width="10"/>-->
                        <!-- 確認チェック -->
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="2" Width="150" Height="60" Grid.RowSpan="3">
                        <TextBox x:Name="TextBox_use_item_name" IsReadOnly="True"
                        Text="{Binding EditTarget.Value.part_name.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"                    
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center" TextAlignment="Left" Width="150" Height="60" Margin="0,2"/>
                    </Border>

                    <!--                   
                    <TextBox Grid.Row="0" Grid.Column="0" Height="60" 
                        Text="{Binding EditTarget.Value.part_name.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"                    
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center" TextAlignment="Left" Width="150" Margin="0,2" Grid.RowSpan="3"/>
                    -->
                    <TextBox Grid.Row="0" Grid.Column="1" Height="Auto" 
                        Text="{Binding EditTarget.Value.part_lot_no_1.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" TextAlignment="Right"  Width="110" Margin="0,1"/>
                    <TextBox Grid.Row="0" Grid.Column="2" Height="Auto" 
                        Text="{Binding EditTarget.Value.out_quantity_1.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" TextAlignment="Right"  Width="100" Margin="0,1"/>
                    <Border Grid.Row="0" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                        <TextBlock Height="Auto" Text="{Binding EditTarget.Value.use_quantity_1.Value, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" TextAlignment="Right"  Width="100" Margin="0,1"/>
                    </Border>

                    <TextBox Grid.Row="0" Grid.Column="4" Height="Auto" 
                        Text="{Binding EditTarget.Value.complete_quantity.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" TextAlignment="Right"  Width="80" Margin="0,1"/>
                    <TextBox Grid.Row="0" Grid.Column="5" Height="Auto"
                        Text="{Binding EditTarget.Value.rem_quantity_1.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" TextAlignment="Right" Width="100" Margin="0,1"/>

                    <TextBox Grid.Row="1" Grid.Column="1" Height="Auto" 
                        Text="{Binding EditTarget.Value.part_lot_no_2.Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" TextAlignment="Right"  Width="110" Margin="0,1"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Height="Auto" 
                        Text="{Binding EditTarget.Value.out_quantity_2.Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" TextAlignment="Right"  Width="100" Margin="0,1"/>
                    <Border Grid.Row="1" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                        <TextBlock Height="Auto" Text="{Binding EditTarget.Value.use_quantity_2.Value, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" TextAlignment="Right"  Width="100" Margin="0,1"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="4" BorderBrush="Black" BorderThickness="1" Style="{StaticResource BorderStyle}">
                        <Label BorderBrush="Black" Content="サンプル数" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0" />
                    </Border>

                    <TextBox Grid.Row="1" Grid.Column="5" Height="Auto"
                        Text="{Binding EditTarget.Value.rem_quantity_2.Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" TextAlignment="Right" Width="100" Margin="0,1"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Height="Auto" 
                        Text="{Binding EditTarget.Value.part_lot_no_3.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" TextAlignment="Right"  Width="110" Margin="0,1"/>
                    <TextBox Grid.Row="2" Grid.Column="2" Height="Auto" 
                        Text="{Binding EditTarget.Value.out_quantity_3.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" TextAlignment="Right"  Width="100" Margin="0,1"/>
                    <TextBox Grid.Row="2" Grid.Column="4" Height="Auto" 
                        Text="{Binding EditTarget.Value.sample_quantity.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" TextAlignment="Right"  Width="80" Margin="0,1"/>
                    <Border Grid.Row="2" Grid.Column="3" BorderBrush="Black" BorderThickness="1">
                        <TextBlock Height="Auto" Text="{Binding EditTarget.Value.use_quantity_3.Value, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" TextAlignment="Right"  Width="100" Margin="0,1"/>
                    </Border>
                    <TextBox Grid.Row="2" Grid.Column="5" Height="Auto"
                        Text="{Binding EditTarget.Value.rem_quantity_3.Value, UpdateSourceTrigger=PropertyChanged}"  ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}"
                        Style="{StaticResource HighlightTextBox}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" TextAlignment="Right" Width="100" Margin="0,1"/>

                </Grid>
            </ScrollViewer>

            <!-- 隙間 -->
            <StackPanel>
                <Border BorderBrush="White" BorderThickness="0" Height="2"  Width="1"></Border>
            </StackPanel>
            <!-- 賞味期限 -->
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="Black" BorderThickness="1" Height="50" Width="75" Style="{StaticResource BorderStyle}">
                    <TextBlock Height="40"  Width="70" Margin="5,5,0,0">賞味期限<LineBreak />梱包年月日</TextBlock>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="50" Width="100" >
                    <!--<TextBlock Tex="{Binding best_before_date, Mode=TwoWay}" Height="24" Width="90" HorizontalAlignment="Center"/>-->
                    <TextBlock Text="{Binding EditTarget.Value.best_before_date.Value, UpdateSourceTrigger=PropertyChanged}" Height="24" Width="90" HorizontalAlignment="Center"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Height="50" Width="75" Style="{StaticResource BorderStyle}">
                    <TextBlock Height="40"  Width="70" Margin="5,0,0,0">失敗・不良<LineBreak />品数</TextBlock>
                </Border>
                <StackPanel Width="75">
                    <Border BorderBrush="Black" BorderThickness="1" Height="50" Width="75" >
                        <TextBox Text="{Binding EditTarget.Value.fail_quantity.Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" Style="{StaticResource HighlightTextBox}" HorizontalContentAlignment="Right"  Height="20" Width="40"/>
                    </Border>
                </StackPanel>
                <StackPanel Width="150">
                    <Border BorderBrush="Black" BorderThickness="1" Height="25" Style="{StaticResource BorderStyle}">
                        <Label BorderBrush="Black" Content="袋詰開始時間" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                    </Border>
                    <Border BorderBrush="Black" BorderThickness="1" Height="25" Style="{StaticResource BorderStyle}">
                        <Label BorderBrush="Black" Content="袋詰終了時間" HorizontalAlignment="Center" VerticalContentAlignment="Center" Padding="0"/>
                    </Border>
                </StackPanel>
                <StackPanel Width="100">
                    <Border BorderBrush="Black" BorderThickness="1" Height="25">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding EditTarget.Value.packing_start_hh.Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" Style="{StaticResource HighlightTextBox}" HorizontalContentAlignment="Right" Width="40"/>
                            <Label BorderBrush="Black" Content="："  Padding="0" Height="20" Width="20" />
                            <TextBox Text="{Binding EditTarget.Value.packing_start_mm.Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" Style="{StaticResource HighlightTextBox}" Width="40"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="Black" BorderThickness="1" Height="25">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding EditTarget.Value.packing_end_hh.Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" Style="{StaticResource HighlightTextBox}" HorizontalContentAlignment="Right" Width="40"/>
                            <Label BorderBrush="Black" Content="："  Padding="0" Height="20" Width="20" />
                            <TextBox Text="{Binding EditTarget.Value.packing_end_mm.Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" Style="{StaticResource HighlightTextBox}" Width="40"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
            <!-- 隙間 -->
            <StackPanel>
                <Label BorderBrush="Black" Padding="0" Height="5" Width="70" FontSize="12" HorizontalAlignment="Left"  VerticalContentAlignment="Bottom"/>
            </StackPanel>
            <!-- 清掃記録 -->
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="White" Height="55" Width="60" >
                    <Label BorderBrush="Black" Content="清掃記録" Padding="0" Height="16" FontSize="12" HorizontalAlignment="Left"  VerticalContentAlignment="Bottom"/>
                </Border>
                <StackPanel Width="150">
