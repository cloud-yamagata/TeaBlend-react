                {type:"text",layout:{x1:410.0,y1:0.0,x2:445.0,y2:25.0},halign:"center",rect:{},text:"＠",valign:"center"},
                {type:"text",layout:{x1:445.0,y1:0.0,x2:480.0,y2:25.0},halign:"center",rect:{},shrink_to_fit:true,text:"歩留(%)",valign:"center"},
                {type:"text",layout:{x1:480.0,y1:0.0,x2:515.0,y2:25.0},halign:"center",rect:{},text:"備考",valign:"center"},
                {type:"line",layout:{x1:515.0,y1:25.0,x2:515.0,y2:50.0}}
