              size: {
                initial: 50.0
              },
              caption: "フッタ",
              every_page: true,
              elements: [
                {type:"field",layout:{x1:340.0,y1:0.0,x2:410.0,y2:25.0},exp:"(+ sum.use_quantity .correct_weight)",formatter:{format:"##0.0#",type:"default"},halign:"right",rect:{},valign:"center"},
                {type:"text",layout:{x1:0.0,y1:0.0,x2:205.0,y2:25.0},halign:"center",rect:{},text:"合計",valign:"center"},
                {type:"field",layout:{x1:410.0,y1:25.0,x2:445.0,y2:50.0},halign:"center",rect:{},valign:"center"},
                {type:"field",layout:{x1:445.0,y1:25.0,x2:480.0,y2:50.0},exp:"(* (/ .complete_quantity sum.use_quantity) 100)",formatter:{format:"##0.0",type:"default"},halign:"center",rect:{},valign:"center"},
                {type:"text",layout:{x1:0.0,y1:25.0,x2:205.0,y2:50.0},halign:"center",rect:{},text:"上り本数",valign:"center"},
                {type:"field",layout:{x1:205.0,y1:25.0,x2:250.0,y2:50.0},exp:".unit_weight",font:{bold:true,size:12.0},formatter:{format:"##0.0#",type:"default"},halign:"right",rect:{},valign:"center"},
