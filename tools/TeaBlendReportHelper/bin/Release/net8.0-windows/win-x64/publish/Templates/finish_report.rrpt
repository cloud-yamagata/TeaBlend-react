{
  version: 0,
  paper: {
    margin: {bottom:30.0,left:40.0,right:40.0,top:20.0},
    scale_unit: "point",
    type: "a4"
  },
  caption: "ブレンド表",
  group: {
    contents: [
      {
        size: {
          initial: 45.0
        },
        caption: "タイトル",
        every_page: true,
        elements: [
          {type:"text",layout:{x1:0.0,y1:0.0,y2:45.0},caption:"タイトル",font:{size:20},halign:"center",text:"製造表(仕上用)",valign:"bottom"},
          {id:"__trial__",type:"text",layout:{y2:10},_:"この要素は手動で編集・削除しないで下さい",background:true,color:"gray",font:{size:10},text:"RapidReport http://rapidreport.systembase.co.jp/"}
        ]
      },
      {
        size: {
          initial: 80.0
        },
        caption: "ヘッダー",
        every_page: true,
        sub: [
          {
            caption: "製造No",
            layout: {x1:0.0,x2:375.0,y1:0.0,y2:30.0},
            elements: [
              {type:"text",layout:{x1:0.0,y1:0.0,x2:45.0,y2:30.0},halign:"center",rect:{},text:"製造No",valign:"center"},
              {type:"field",layout:{x1:45.0,y1:0.0,x2:130.0,y2:30.0},exp:"(& .organic_class_base '-' .product_no)",font:{bold:true,size:12.0},halign:"center",rect:{},valign:"center"},
              {type:"field",layout:{x1:175.0,y1:0.0,x2:260.0,y2:30.0},exp:"(&\r\n   (if (= .make_year '') '' (& '(' .make_year ')' ))\r\n   .blend_name_base   \r\n   (if (= .count '') '' (& '(' .count ')' ))\r\n)",halign:"left",mock:"w10 => Ｘ＃＃＃＃＃＃＃＃Ｘ",rect:{},shrink_to_fit:true,valign:"center"},
              {type:"text",layout:{x1:130.0,y1:0.0,x2:175.0,y2:30.0},font:{},halign:"center",rect:{},text:"仕上り後\r\n荷印",valign:"center"},
              {type:"field",layout:{x1:260.0,y1:0.0,x2:375.0,y2:30.0},exp:".lot_name",halign:"left",mock:"w10 => Ｘ＃＃＃＃＃＃＃＃Ｘ",rect:{},valign:"center",wrap:true}
            ]
          },
          {
            caption: "製造日",
            layout: {rev_x2:true,x1:375.0,x2:0.0,y1:0.0,y2:30.0},
            elements: [
              {type:"field",layout:{x1:0.0,y1:0.0,x2:40.0,y2:30.0},exp:"(year .work_date)",font:{size:10.0},formatter:{format:"####",type:"default"},halign:"right",valign:"center"},
              {type:"field",layout:{x1:60.0,y1:0.0,x2:80.0,y2:30.0},exp:"(month .work_date)",font:{size:10.0},formatter:{format:"##",type:"default"},halign:"right",valign:"center"},
              {type:"field",layout:{x1:100.0,y1:0.0,x2:120.0,y2:30.0},exp:"(day .work_date)",font:{size:10.0},formatter:{format:"##",type:"default"},halign:"right",valign:"center"},
              {type:"line",layout:{x1:0.0,y1:30.0,x2:140.0,y2:30.0}},
              {type:"text",layout:{x1:40.0,y1:0.0,x2:60.0,y2:30.0},font:{size:10.0},formatter:{format:"##",type:"default"},halign:"center",text:"年",valign:"center"},
              {type:"text",layout:{x1:80.0,y1:0.0,x2:100.0,y2:30.0},font:{size:10.0},formatter:{format:"##",type:"default"},halign:"center",text:"月",valign:"center"},
              {type:"text",layout:{x1:120.0,y1:0.0,x2:140.0,y2:30.0},font:{size:10.0},formatter:{format:"##",type:"default"},halign:"center",text:"日",valign:"center"}
            ]
          },
          {
            caption: "使用機械",
            layout: {x1:0.0,x2:375.0,y1:40.0,y2:0.0},
            elements: [
              {type:"text",layout:{x1:0.0,y1:0.0,x2:230.0,y2:20.0},halign:"center",text:"使用機械",valign:"center"},
              {type:"text",layout:{x1:20.0,y1:20.0,x2:80.0,y2:40.0},halign:"center",text:"①号2000kg",valign:"center"},
              {type:"text",layout:{x1:105.0,y1:20.0,x2:165.0,y2:40.0},halign:"center",text:"②号500kg",valign:"center"},
              {type:"text",layout:{x1:190.0,y1:20.0,x2:230.0,y2:40.0},halign:"center",text:"③茶箱",valign:"center"},
              {type:"field",layout:{x1:5.0,y1:25.0,x2:15.0,y2:35.0},exp:"(if (= .use_device_unit1_chk true) 'レ' '')",font:{size:10.0},formatter:{format:"##0.0#",type:"default"},halign:"center",rect:{},shrink_to_fit:true,valign:"center"},
              {type:"field",layout:{x1:90.0,y1:25.0,x2:100.0,y2:35.0},exp:"(if (= .use_device_unit2_chk true) 'レ' '')",font:{size:10.0},formatter:{format:"##0.0#",type:"default"},halign:"center",rect:{},shrink_to_fit:true,valign:"center"},
              {type:"field",layout:{x1:170.0,y1:25.0,x2:180.0,y2:35.0},exp:"(if (= .use_device_unit3_chk true) 'レ' '')",font:{size:10.0},formatter:{format:"##0.0#",type:"default"},halign:"center",rect:{},shrink_to_fit:true,valign:"center"},
              {type:"text",layout:{x1:0.0,y1:0.0,x2:230.0,y2:40.0},halign:"center",rect:{},valign:"center"}
            ]
          },
          {
            caption: "室内温度",
            layout: {x1:260.0,x2:515.0,y1:45.0,y2:60.0},
            elements: [
              {type:"text",layout:{x1:0.0,y1:0.0,x2:50.0,y2:15.0},font:{size:10.0},formatter:{format:"##",type:"default"},halign:"center",text:"室内温度・湿度",valign:"center"},
              {type:"field",layout:{x1:50.0,y1:0.0,x2:70.0,y2:15.0},exp:".temperature",font:{size:10.0},formatter:{format:"####",type:"default"},halign:"right",valign:"center"},
              {type:"text",layout:{x1:70.0,y1:0.0,x2:85.0,y2:15.0},font:{size:10.0},formatter:{format:"##",type:"default"},halign:"center",text:"℃",valign:"center"},
              {type:"field",layout:{x1:85.0,y1:0.0,x2:105.0,y2:15.0},exp:".humidity",font:{size:10.0},formatter:{format:"####",type:"default"},halign:"right",valign:"center"},
              {type:"text",layout:{x1:105.0,y1:0.0,x2:120.0,y2:15.0},font:{size:10.0},formatter:{format:"##",type:"default"},halign:"center",text:"％",valign:"center"},
              {type:"text",layout:{x1:120.0,y1:0.0,x2:170.0,y2:15.0},font:{size:10.0},formatter:{format:"##",type:"default"},halign:"center",text:"担当",valign:"center"},
              {type:"line",layout:{x1:0.0,y1:15.0,x2:255.0,y2:15.0}}
            ]
          }
        ]
      },
      {
        size: {
          initial: 5.0
        },
        caption: "余白",
        every_page: true
      },
      {
        size: {
          initial: 200.0
        },
        caption: "使用部品",
        elements: [
          {type:"text",layout:{x1:0,y1:770,x2:555,y2:800},caption:"ページ数",halign:"center",text:"#{page_count}/#{page_count.total}",valign:"center"}
        ],
        group: {
          layout: {},
          contents: [
            {
              size: {
                initial: 30.0
              },
              aggregate_src: true,
              caption: "ヘッダ",
              every_page: true,
              elements: [
                {type:"text",layout:{x1:0.0,y1:0.0,x2:205.0,y2:30.0},customize:[{}],formatter:{type:"default"},halign:"center",rect:{},text:"使用茶　品名・品番",valign:"center"},
                {type:"text",layout:{x1:205.0,y1:0.0,x2:340.0,y2:30.0},halign:"center",rect:{},text:"Kg　×　個数　＋　半端",valign:"center"},
                {type:"text",layout:{x1:340.0,y1:0.0,x2:410.0,y2:30.0},halign:"center",rect:{},text:"総数量",valign:"center"},
                {type:"text",layout:{x1:410.0,y1:0.0,x2:515.0,y2:15.0},halign:"center",rect:{},text:"原料ラベル確認",valign:"center"},
                {type:"text",layout:{x1:410.0,y1:15.0,x2:445.0,y2:30.0},background:true,color:"white",font:{size:9.0},formatter:{type:"default"},halign:"center",rect:{fill_color:"black"},shrink_to_fit:true,text:"JAS有機",valign:"center"},
                {type:"text",layout:{x1:445.0,y1:15.0,x2:480.0,y2:30.0},background:true,color:"white",font:{size:9.0},formatter:{type:"default"},halign:"center",rect:{fill_color:"black"},text:"無農薬",valign:"center"},
                {type:"text",layout:{x1:480.0,y1:15.0,x2:515.0,y2:30.0},background:true,color:"white",font:{size:9.0},formatter:{type:"default"},halign:"center",rect:{fill_color:"black"},text:"一般",valign:"center"}
              ]
            },
            {
              size: {
                initial: 140.0
              },
              caption: "ボディ",
              group: {
                caption: "明細グループ",
                detail: true,
                layout: {
                  max_count: 7.0,
                  blank: true
                },
                custom_fields: [
                  {}
                ],
                contents: [
                  {
                    size: {
                      initial: 20.0
                    },
                    caption: "明細",
                    elements: [
                      {type:"field",layout:{x1:205.0,y1:0.0,x2:250.0,y2:20.0},formatter:{format:"##0.0#",type:"default"},halign:"center",rect:{},valign:"center"},
                      {type:"field",layout:{x1:0.0,y1:0.0,x2:205.0,y2:20.0},exp:".part_lot_name",halign:"left",rect:{},valign:"center"},
                      {type:"field",layout:{x1:340.0,y1:0.0,x2:410.0,y2:20.0},decimal_place:1.0,exp:".use_quantity",formatter:{format:"##0.0#",type:"default"},halign:"right",rect:{},valign:"center"},
                      {type:"field",layout:{x1:410.0,y1:0.0,x2:445.0,y2:20.0},exp:"(if (= .organic_class_part 'A') '○' '')",halign:"center",rect:{},valign:"center"},
                      {type:"field",layout:{x1:445.0,y1:0.0,x2:480.0,y2:20.0},exp:"(if (= .organic_class_part 'B') '○' '')",halign:"center",rect:{},valign:"center"},
                      {type:"field",layout:{x1:480.0,y1:0.0,x2:515.0,y2:20.0},exp:"(if (= .organic_class_part 'C') '○' '')",halign:"center",rect:{},valign:"center"},
                      {type:"field",layout:{x1:250.0,y1:0.0,x2:295.0,y2:20.0},formatter:{format:"##",type:"default"},halign:"center",rect:{},valign:"center"},
                      {type:"field",layout:{x1:295.0,y1:0.0,x2:340.0,y2:20.0},formatter:{format:"##0.0#",type:"default"},halign:"center",rect:{},valign:"center"}
                    ]
